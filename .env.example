# Copy this file to .env and fill in what you need. `config.py` loads .env
# automatically (via python-dotenv) -- nothing else needs to change.
#
#     cp .env.example .env
#
# .env itself is gitignored -- never commit real keys.

# --------------------------------------------------------------------------- #
# FRED API (macro data: mortgage rate, CPI, unemployment)
# --------------------------------------------------------------------------- #
# Optional. Free, instant signup at https://fred.stlouisfed.org/docs/api/api_key.html
# Without this, the pipeline automatically falls back to real cached
# historical FRED figures (2006-2010) -- it still runs, just not "live".
FRED_API_KEY=

# --------------------------------------------------------------------------- #
# Database (api_service.py audit trail)
# --------------------------------------------------------------------------- #
# Optional. Defaults to a local SQLite file (artifacts/underwriting.db) if
# unset. Set this to point the API at Postgres instead, e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --------------------------------------------------------------------------- #
# Not env-configurable / no key needed
# --------------------------------------------------------------------------- #
# OpenStreetMap Nominatim (neighborhood geocoding) and the OSM Overpass API
# (highway/rail/park proximity) are both free and keyless -- they just need
# outbound network access. See config.py's NOMINATIM_* / OSM_* settings if
# you want to tune timeouts or request rate, but there's no key to set here.
